rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true; // Public access to job listings
      allow write: if false; // Only server (Admin SDK) should write
    }

    // Profiles collection
    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
      
      // Validation for profile
      function isValidProfile(data) {
        return data.fullName is string && data.fullName.size() <= 100
            && data.age is number && data.age >= 18 && data.age <= 100;
      }
    }
  }
}
