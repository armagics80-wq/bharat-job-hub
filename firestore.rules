rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Jobs collection - Strict read access
    match /jobs/{jobId} {
      allow get: if isValidId(jobId);
      allow list: if true; 
      allow write: if false; 
    }

    // Profiles collection - Hardened Identity logic
    match /profiles/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidProfile(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'age', 'qualifications', 'state', 'district', 'gender', 'isPWD', 'skills', 'documents', 'otherCertificates', 'preferredRegion', 'subscriptions', 'updatedAt'])
      );
      allow delete: if false;
      
      function isValidProfile(data) {
        return data.fullName is string && data.fullName.size() <= 100
            && data.age is number && data.age >= 18 && data.age <= 100
            && data.state is string && data.state.size() <= 50;
      }
    }

    // Activity collection
    match /activity/{activityId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
