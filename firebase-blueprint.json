{
  "entities": {
    "Department": {
      "title": "Government Department",
      "description": "Details about a government department or agency",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "oldNames": { "type": "array", "items": { "type": "string" } },
        "officialUrl": { "type": "string" },
        "state": { "type": "string", "enum": ["Central", "Telangana", "Andhra Pradesh"] },
        "category": { "type": "string" },
        "verified": { "type": "boolean" },
        "lastVerifiedOn": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "officialUrl", "state", "category", "verified"]
    },
    "Job": {
      "title": "Government Job Notification",
      "description": "Details about a government job vacancy",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "departmentId": { "type": "string" },
        "region": { "type": "string", "enum": ["Central", "Telangana", "Andhra Pradesh"] },
        "qualification": { "type": "string" },
        "minAge": { "type": "number" },
        "maxAge": { "type": "number" },
        "salary": { "type": "string" },
        "lastDate": { "type": "string", "format": "date-time" },
        "notificationDate": { "type": "string", "format": "date-time" },
        "applyLink": { "type": "string" },
        "officialSource": { "type": "string" },
        "description": { "type": "string" },
        "documentRequired": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Expired", "Upcoming", "Exam Scheduled"] }
      },
      "required": ["title", "departmentId", "region", "qualification", "lastDate", "status"]
    },
    "UserProfile": {
      "title": "User Eligibility Profile",
      "description": "User's details for job matching",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "age": { "type": "number" },
        "qualification": { "type": "string" },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "isPWD": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string" } },
        "otherCertificates": { "type": "string" },
        "preferredRegion": { "type": "string" },
        "subscriptions": {
          "type": "object",
          "properties": {
            "regions": { "type": "array", "items": { "type": "string" } },
            "categories": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "required": ["fullName", "age", "qualification", "state", "district"]
    }
  },
  "firestore": {
    "departments": {
      "schema": "Department",
      "description": "Store all government department information"
    },
    "jobs": {
      "schema": "Job",
      "description": "Store all government job notifications"
    },
    "userProfiles": {
      "schema": "UserProfile",
      "description": "Store user profiles for matching"
    }
  }
}
