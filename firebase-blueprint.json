{
  "entities": {
    "Job": {
      "title": "Government Job",
      "description": "Details of a government job notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "departmentId": { "type": "string" },
        "region": { "type": "string", "enum": ["Central", "Telangana", "Andhra Pradesh"] },
        "qualification": { "type": "string" },
        "minQualification": { "type": "string" },
        "allowedQualifications": { "type": "array", "items": { "type": "string" } },
        "minAge": { "type": "number" },
        "maxAge": { "type": "number" },
        "salary": { "type": "string" },
        "lastDate": { "type": "string", "format": "date-time" },
        "notificationDate": { "type": "string", "format": "date-time" },
        "applyLink": { "type": "string" },
        "officialSource": { "type": "string" },
        "description": { "type": "string" },
        "jobType": { "type": "string" },
        "jobCategory": { "type": "string" },
        "natureOfWork": { "type": "string" },
        "selectionProcess": { "type": "string" },
        "examPattern": { "type": "string" },
        "reservationDetails": { "type": "string" },
        "examDate": { "type": "string" },
        "location": { "type": "string" },
        "howToApplySteps": { "type": "array", "items": { "type": "string" } },
        "applicationFee": { "type": "string" },
        "documentRequired": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Active", "Upcoming", "Expired"] },
        "sourceType": { "type": "string", "enum": ["Official Notification", "Upcoming Opportunity", "Media Prediction"] },
        "verified": { "type": "boolean" },
        "verificationStatus": { "type": "string" },
        "lastVerifiedAt": { "type": "string", "format": "date-time" },
        "lastCheckedAt": { "type": "string", "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" },
        "officialPdfUrl": { "type": "string" }
      },
      "required": ["id", "title", "departmentId", "region", "minQualification", "lastDate", "notificationDate", "applyLink", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User eligibility profile and preferences",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "age": { "type": "number" },
        "qualifications": { "type": "array", "items": { "type": "string" } },
        "state": { "type": "string" },
        "district": { "type": "string" },
        "gender": { "type": "string" },
        "isPWD": { "type": "boolean" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "documents": { "type": "array", "items": { "type": "string" } },
        "otherCertificates": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Public database of government jobs"
    },
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Private user eligibility profiles"
    }
  }
}
